{
  "name": "serverplugin-core",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "spc": "bin/spc.mjs",
    "spcdev": "bin/spcdev.mjs"
  },
  "type": "module",
  "description": "Plugin-driven server management core (spike)",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "spike": "tsx core/main.ts",
    "daemon": "tsx core/server.ts",
    "spc": "tsx core/cli.ts",
    "spcdev": "tsx core/cli-dev.ts",
    "verify:sandbox": "node scripts/verify-quickjs-patch.mjs",
    "test": "tsx --test sdk/__tests__/*.test.ts core/__tests__/*.test.ts build/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "quickjs-emscripten": "^0.32.0",
    "semver": "^7.8.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  }
}
