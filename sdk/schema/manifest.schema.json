{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spc.xfyweb.cn/schema/manifest.schema.json",
  "title": "ServerPluginCore Plugin Manifest",
  "description": "插件清单（schema 2）。单一事实源：SDK 校验器、核心加载器、市场上传校验共用。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version"
  ],
  "if": {
    "properties": {
      "type": {
        "const": "theme"
      }
    },
    "required": [
      "type"
    ]
  },
  "then": {
    "required": [
      "theme"
    ],
    "properties": {
      "theme": true
    }
  },
  "else": {
    "required": [
      "runtime",
      "permissions"
    ],
    "properties": {
      "runtime": true,
      "permissions": true
    }
  },
  "properties": {
    "schema": {
      "const": 2
    },
    "type": {
      "description": "插件类型：ability(能力插件,默认,沙箱内挂载管理页面) | driver(驱动插件,核心端特权,注册API端点并自行鉴权,严审) | hook(协作插件,事件钩子,位置/权限设计中) | theme(主题包,声明式令牌+资源,无JS/无沙箱)",
      "enum": [
        "ability",
        "driver",
        "hook",
        "theme"
      ],
      "default": "ability"
    },
    "frontend": {
      "description": "前端形态（P3）：declarative = manifest 声明组件树、核心渲染（插件代码不执行）；iframe = 插件 bundle 在核心前端的隔离 iframe 内运行（sandbox 无 allow-same-origin、CSP 零出网）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "declarative",
            "iframe"
          ]
        }
      }
    },
    "intent": {
      "description": "插件可从核心前端收到的用户意图声明（P3）。核心代理按此校验形状，违规即 INTENT_SCHEMA_VIOLATION；资源内容默认不随意图下发（只给引用，要内容需持 grantId 调沙箱 API）",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_]*$"
          },
          "kind": {
            "enum": [
              "selection",
              "text",
              "enum"
            ]
          },
          "resource": {
            "description": "kind=selection：资源类型",
            "enum": [
              "path",
              "session"
            ]
          },
          "types": {
            "type": "array",
            "items": {
              "enum": [
                "file",
                "dir"
              ]
            }
          },
          "maxCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "configSchema": {
      "description": "插件配置声明（JSON Schema 子集）。宿主据此校验值文件、补默认值，并把**只读快照**注入 ctx.config（插件只能读）；面板在 P3 据此渲染表单。authored 在 manifest 里而不是插件目录里——与其它声明共用同一份单一事实源。",
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "array"
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 300
              },
              "default": {},
              "enum": {
                "type": "array",
                "minItems": 1
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0
              },
              "maxLength": {
                "type": "integer",
                "minimum": 0
              },
              "pattern": {
                "type": "string"
              },
              "items": {
                "type": "object"
              },
              "secret": {
                "description": "敏感值：面板掩码显示，日志与审计一律摘要（不落明文）",
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "theme": {
      "description": "主题包入口（仅 type=theme 使用），如 theme.json；主题 = 声明式设计令牌 + 资源 + 受限样式，无 JS",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "id": {
      "description": "发布者命名空间 id：@<username>/<name>（市场内唯一；跨市场全局唯一性由完整引用 <origin>/@<username>/<name> 提供）",
      "type": "string",
      "pattern": "^@[a-z0-9][a-z0-9_-]{0,62}/[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "object",
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "程序化比较用（升级判断），整数递增",
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "description": "展示用 semver",
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "compat": {
      "description": "核心版本兼容：minCore 必填，targetCore 可选",
      "type": "object",
      "required": [
        "minCore"
      ],
      "additionalProperties": false,
      "properties": {
        "minCore": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "targetCore": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "作者 ID：<username>@<源域名>（可选；填写时须与 id 的命名空间、源域名一致，否则 AUTHOR_MISMATCH）",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}@[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:\\d{1,5})?$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "homepage": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "entry": {
      "description": "构建源入口（如 main.ts/main.js），构建层从这里开始打包；缺省 main.ts",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "default": "main.ts"
    },
    "runtime": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "quickjs",
            "node-child"
          ]
        },
        "esm": {
          "description": "ESM-only 是硬约束（ADR-005），schema 层面拒绝非 ESM 插件",
          "const": true
        }
      }
    },
    "permissions": {
      "description": "权限请求（uses-permission 语义）：无默认放行，必须显式声明",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$",
            "type": "string"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webApis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/api/"
              },
              "permission": {
                "type": "string"
              }
            }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "title": {
                "type": "string",
                "maxLength": 64
              },
              "icon": {
                "type": "string",
                "maxLength": 64
              },
              "order": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publish": {
              "description": "发布的事件：显式声明 topic + 保密等级（public/sensitive/secret）",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "topic",
                  "classification"
                ],
                "additionalProperties": false,
                "properties": {
                  "topic": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
                  },
                  "classification": {
                    "enum": [
                      "public",
                      "sensitive",
                      "secret"
                    ]
                  }
                }
              }
            },
            "subscribe": {
              "description": "订阅的事件：mode = notify(只读通知，宽松) | arbitrate(裁决修改，严格)",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "topic",
                  "mode"
                ],
                "additionalProperties": false,
                "properties": {
                  "topic": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
                  },
                  "mode": {
                    "enum": [
                      "notify",
                      "arbitrate"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": {
          "description": "npm 依赖声明。构建期由**构建器**解析真实闭包并做能力检查（能带/不能带）；**没有信任分级**，也不产生任何用户放行动作——见 ADR-005 §7 v2",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 214
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "plugins": {
          "description": "插件间显式可见性（ADR-005：默认不可见，声明才可交互）",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^@[a-z0-9][a-z0-9_-]{0,62}/[a-z0-9][a-z0-9_-]{0,62}$"
              },
              "origin": {
                "description": "跨源依赖：源域名（同源依赖省略；本机开发市场用 localhost 或 localhost:port）。缺少的源不会自动添加，只提示管理员",
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:\\d{1,5})?$"
              },
              "version": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        }
      }
    }
  }
}
