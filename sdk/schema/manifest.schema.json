{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spc.xfyweb.cn/schema/manifest.schema.json",
  "title": "ServerPluginCore Plugin Manifest",
  "description": "插件清单（schema 2）。单一事实源：SDK 校验器、核心加载器、市场上传校验共用。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version"
  ],
  "if": {
    "properties": {
      "type": {
        "const": "theme"
      }
    },
    "required": [
      "type"
    ]
  },
  "then": {
    "required": [
      "theme"
    ],
    "properties": {
      "theme": true
    }
  },
  "else": {
    "required": [
      "runtime",
      "permissions"
    ],
    "properties": {
      "runtime": true,
      "permissions": true
    }
  },
  "properties": {
    "schema": {
      "const": 2
    },
    "type": {
      "description": "插件类型：ability(能力插件,默认,沙箱内挂载管理页面) | driver(驱动插件,核心端特权,注册API端点并自行鉴权,严审) | hook(协作插件,核心在决策点上回调它、答复进核心决策,中间件,与ability的差别是调用方向相反,P2不做) | theme(主题包,声明式令牌+资源,无JS/无沙箱)",
      "enum": [
        "ability",
        "driver",
        "hook",
        "theme"
      ],
      "default": "ability"
    },
    "frontend": {
      "description": "前端形态（P3）：declarative = manifest 声明组件树、核心渲染（插件代码不执行）；iframe = 插件 bundle 在核心前端的隔离 iframe 内运行（sandbox 无 allow-same-origin、CSP 零出网）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "declarative",
            "iframe"
          ]
        }
      }
    },
    "intent": {
      "description": "插件可从核心前端收到的用户意图声明（P3）。核心代理按此校验形状，违规即 INTENT_SCHEMA_VIOLATION；资源内容默认不随意图下发（只给引用，要内容需持 grantId 调沙箱 API）",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_]*$"
          },
          "kind": {
            "enum": [
              "selection",
              "text",
              "enum"
            ]
          },
          "resource": {
            "description": "kind=selection：资源类型",
            "enum": [
              "path",
              "session"
            ]
          },
          "types": {
            "type": "array",
            "items": {
              "enum": [
                "file",
                "dir"
              ]
            }
          },
          "maxCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "configSchema": {
      "description": "插件配置声明（JSON Schema 子集）。宿主据此校验值文件、补默认值，并把**只读快照**注入 ctx.config（插件只能读）；面板在 P3 据此渲染表单。authored 在 manifest 里而不是插件目录里——与其它声明共用同一份单一事实源。",
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "array"
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 300
              },
              "default": {},
              "enum": {
                "type": "array",
                "minItems": 1
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0
              },
              "maxLength": {
                "type": "integer",
                "minimum": 0
              },
              "pattern": {
                "type": "string"
              },
              "items": {
                "type": "object"
              },
              "secret": {
                "description": "敏感值：面板掩码显示，日志与审计一律摘要（不落明文）",
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "theme": {
      "description": "主题包入口（仅 type=theme 使用），如 theme.json；主题 = 声明式设计令牌 + 资源 + 受限样式，无 JS",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "id": {
      "description": "发布者命名空间 id：@<username>/<name>（市场内唯一；跨市场全局唯一性由完整引用 <origin>/@<username>/<name> 提供）",
      "type": "string",
      "pattern": "^@[a-z0-9][a-z0-9_-]{0,62}/[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "object",
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "程序化比较用（升级判断），整数递增",
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "description": "展示用 semver",
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "compat": {
      "description": "核心版本兼容：minCore 必填，targetCore 可选",
      "type": "object",
      "required": [
        "minCore"
      ],
      "additionalProperties": false,
      "properties": {
        "minCore": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "targetCore": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "作者 ID：<username>@<源域名>（可选；填写时须与 id 的命名空间、源域名一致，否则 AUTHOR_MISMATCH）",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}@[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:\\d{1,5})?$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "homepage": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "entry": {
      "description": "构建源入口（如 main.ts/main.js），构建层从这里开始打包；缺省 main.ts",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "default": "main.ts"
    },
    "runtime": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "运行时后端。**只有 quickjs**（核心进程内的 QuickJS 沙箱）：node-child（子进程档）已于 2026-09-25 砍掉 —— 零实现，且它不是沙箱（有 node API ⇒ 只能靠内核层 Landlock/seccomp 兜底，那套 Windows 上还没有）。枚举保留单值是为了将来真要第二后端时不必动清单格式。",
          "enum": [
            "quickjs"
          ]
        },
        "esm": {
          "description": "ESM-only 是硬约束（ADR-005），schema 层面拒绝非 ESM 插件",
          "const": true
        }
      }
    },
    "permissions": {
      "description": "权限请求（uses-permission 语义）：无默认放行，必须显式声明",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "权限点名。静态点：`<group>.<action>[.<scope>]`（如 fs.write.data）。动态点：核心按**完整引用**生成，只有两种 —— `plugins.call.<origin>/@user/name.<path>`（调用别人的端点）、`events.subscribe.<origin>/@user/name.<topic>`（订阅别人的事件），见 docs/events-and-hooks-design.md §3.4。动态点里**不许出现 `*`**：通配声明会把「新增端点/新增订阅走增量同意」（§3.7）变成一次性全授。语法之外还有一道语义闸：点名必须**已由某个插件登记**，未知即拒绝（UNKNOWN_POINT）",
            "pattern": "^(?:[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+|(?:plugins\\.call|events\\.subscribe)\\.[^\\s*]+)$",
            "type": "string"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "description": "对外端点（原 webApis，改名理由见 docs/events-and-hooks-design.md §3.1）：调用者有两类——面板的 HTTP 网关与其他插件。实现方式：入口模块导出 endpoints 映射（`export const endpoints = { '<path>': (ctx, paramsJson, bytes) => jsonText }`），宿主装载时逐条核对「声明 ⟺ 实现」，对不上即 PLUGIN_EXPORT_INVALID。⛔ path **不带源、也不需要全局唯一**：调用方要把同一条 path 写进自己的 call 列表，两处都在被签名的字节里（带源就等于换源即断）；端点按 `(完整引用, path)` 归属，跨插件同名端点不是冲突。见 docs/events-and-hooks-design.md §3.1",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/api/"
              },
              "permission": {
                "type": "string"
              },
              "callable": {
                "description": "谁能调这个端点，缺省 [\"panel\"]（fail-closed：不声明就不能被插件调用）。'plugins' = 允许其他插件经 plugins.call(句柄, path, …) 调用它（docs/events-and-hooks-design.md §3.7 门槛三）",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "panel",
                    "plugins"
                  ]
                }
              }
            }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "title": {
                "type": "string",
                "maxLength": 64
              },
              "icon": {
                "type": "string",
                "maxLength": 64
              },
              "order": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publish": {
              "description": "发布的事件：显式声明 topic + 保密等级（public/sensitive/secret）",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "topic",
                  "classification"
                ],
                "additionalProperties": false,
                "properties": {
                  "topic": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
                  },
                  "classification": {
                    "enum": [
                      "public",
                      "sensitive",
                      "secret"
                    ]
                  }
                }
              }
            },
            "subscribe": {
              "description": "订阅的事件：mode = notify(只读通知，宽松) | arbitrate(裁决修改，严格)",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "topic",
                  "mode"
                ],
                "additionalProperties": false,
                "properties": {
                  "topic": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
                  },
                  "mode": {
                    "enum": [
                      "notify",
                      "arbitrate"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": {
          "description": "npm 依赖声明。构建期由**构建器**解析真实闭包并做能力检查（能带/不能带）；**没有信任分级**，也不产生任何用户放行动作——见 ADR-005 §7 v2",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 214
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "plugins": {
          "description": "插件间显式可见性（ADR-005：默认不可见，声明才可交互）",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "author"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^@[a-z0-9][a-z0-9_-]{0,62}/[a-z0-9][a-z0-9_-]{0,62}$"
              },
              "as": {
                "description": "包内别名 = 调用句柄（plugins.call('<as>', '/api/…')）。没写就用 id。同一清单里句柄（as ?? id）必须唯一 —— 歧义在清单校验期挡掉，代码里因此永远无歧义",
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
              },
              "call": {
                "description": "调用面的请求：我要调它的哪些端点（path 列表）。它替代 permissions[] 里那条带源的动态点名 —— 声明不带源（在被签名的包里）、授权带源（plugins.call.<实际引用>.<path>）",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/api/"
                }
              },
              "origin": {
                "description": "依赖的**来源**，写法按目标分（docs/events-and-hooks-design.md §3.5 的四格表）：目标在市场 ⇒ 必填域名；目标是本地源 ⇒ **省略**（在本地源范围内按 author.pub + id 唯一匹配；写明 `local:<名字>` 则精确匹配该桶）；**市场包不许依赖本地源**",
                "type": "string",
                "pattern": "^(local:[a-z0-9][a-z0-9_-]{0,31}|[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:[0-9]{1,5})?)$"
              },
              "version": {
                "type": "string",
                "maxLength": 64
              },
              "author": {
                "description": "作者公钥（v4，必填）：`id` 与 `author.id` 都不唯一 ⇒ **唯一性来自 origin、同一性来自公钥**。宿主在安装期用名册里的记忆核对，绝不比包内自述",
                "type": "object",
                "required": [
                  "pub"
                ],
                "additionalProperties": false,
                "properties": {
                  "pub": {
                    "description": "base64 裸 32 字节 Ed25519 公钥（44 字符，末尾一个 `=`）",
                    "type": "string",
                    "pattern": "^[A-Za-z0-9+/]{43}=$"
                  },
                  "fingerprint": {
                    "description": "`sha256:` + 裸公钥的 sha256；写了必须与 pub 自洽（判定比公钥，指纹只用于展示/审计）",
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
